# Copiar este archivo como .env y completar únicamente valores locales.
# Nunca confirmar .env al repositorio.

CI_ENVIRONMENT = development

app.baseURL = 'http://localhost/Tesoros/'
app.indexPage = ''
app.defaultLocale = 'es'
app.appTimezone = 'America/Mexico_City'
app.forceGlobalSecureRequests = false
app.CSPEnabled = true

# Fecha oficial pendiente. Formato local America/Mexico_City: YYYY-MM-DD HH:MM:SS
convocation.closeAt =

# API institucional de accesos. Solicitar una clave propia para este sistema.
adminAuth.baseUrl = https://accesos.digitalneza.com/
adminAuth.systemKey =
adminAuth.timeoutSeconds = 10
adminAuth.connectTimeoutSeconds = 5
adminAuth.verifyTls = true

# Ruta opcional a un paquete CA cuando PHP/Apache no tenga uno configurado.
# En producción es preferible configurarlo globalmente en PHP.
http.caBundle =

database.default.hostname = localhost
database.default.database = tesoros
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Base exclusiva para pruebas automatizadas. Nunca usar la base principal.
database.tests.hostname = 127.0.0.1
database.tests.database = tesoros_test
database.tests.username = root
database.tests.password =
database.tests.DBDriver = MySQLi
database.tests.DBPrefix =

cookie.prefix = 'tg_'
cookie.secure = false
cookie.httponly = true
cookie.samesite = 'Lax'

session.cookieName = 'tg_session'
session.expiration = 7200
session.regenerateDestroy = true

security.csrfProtection = 'session'
security.tokenName = 'tg_csrf_token'
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'tg_csrf_cookie'

logger.threshold = 9

# Integraciones externas. No usar valores ficticios en producción.
recaptcha.siteKey =
recaptcha.secretKey =
# Solo para desarrollo local. En producción siempre se ignora el bypass.
recaptcha.allowDevelopmentBypass = true
email.fromEmail =
email.fromName = 'Tesoros Gastronómicos'

# SMTP. Completar únicamente en .env local; nunca confirmar credenciales.
MAIL_MAILER = smtp
MAIL_HOST =
MAIL_PORT = 2525
MAIL_USERNAME =
MAIL_PASSWORD =
MAIL_ENCRYPTION = tls
MAIL_FROM_ADDRESS =
MAIL_FROM_NAME = 'Tesoros Gastronómicos'

# Videos privados. En producción el antivirus es obligatorio y el comando debe
# devolver 0 cuando el archivo sea seguro. Ejemplo: clamscan --no-summary {file}
videoUploads.antivirusCommand =
videoUploads.allowDevelopmentAntivirusBypass = true

# Documentos privados PDF/JPG/JPEG. En producción el antivirus es obligatorio.
# El marcador {file} se sustituye por la ruta temporal escapada.
uploads.antivirusCommand =
uploads.allowDevelopmentAntivirusBypass = true
